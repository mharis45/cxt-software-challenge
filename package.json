{
  "name": "my-demo-app-mobile-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Appium + WebdriverIO + TypeScript UI automation suite for Sauce Labs' My Demo App (Android) — Mobile Automation Engineer challenge",
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:login": "wdio run ./wdio.conf.ts --spec ./test/specs/login.spec.ts",
    "test:catalog": "wdio run ./wdio.conf.ts --spec ./test/specs/catalog.spec.ts",
    "test:cart": "wdio run ./wdio.conf.ts --spec ./test/specs/cart.spec.ts",
    "test:checkout": "wdio run ./wdio.conf.ts --spec ./test/specs/checkout.spec.ts",
    "typecheck": "tsc --noEmit",
    "report": "allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.4.0",
    "@wdio/appium-service": "^9.4.0",
    "@wdio/cli": "^9.4.0",
    "@wdio/local-runner": "^9.4.0",
    "@wdio/mocha-framework": "^9.4.0",
    "@wdio/spec-reporter": "^9.4.0",
    "allure-commandline": "^2.30.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.7.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
